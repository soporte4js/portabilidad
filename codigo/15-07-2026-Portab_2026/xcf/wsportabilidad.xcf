<?xml version="1.0" encoding="UTF-8" ?>
<APPLICATION Parent="ws.default" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.4js.com/ns/gas/4.01/cfextws.xsd">
  <EXECUTION>
    <ENVIRONMENT_VARIABLE Id="LANG">en_US.utf8</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="FGL_LENGTH_SEMANTICS">CHAR</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="CLIENT_LOCALE">en_US.UTF8</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="DB_LOCALE">en_US.819</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="DBDATE">dmy4/</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="FGLSQLDEBUG">9</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="FGLWSDEBUG">9</ENVIRONMENT_VARIABLE>
    <PATH>$(res.deployment.path)</PATH>
    <MODULE>rwsServiciosISSSTE.42r</MODULE>
    <POOL>
        <START>1</START>
        <MIN_AVAILABLE>1</MIN_AVAILABLE>
        <MAX_AVAILABLE>10</MAX_AVAILABLE>
    </POOL>
  </EXECUTION>
</APPLICATION>