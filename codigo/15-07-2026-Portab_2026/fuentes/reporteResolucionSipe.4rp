    <rtl:stylesheet>
        <PXML>
            <rtl:match name="Report" nameConstraint="Report" minOccurs="1" maxOccurs="1">
                <MINIPAGE name="Page Root" width="18.5cm" length="max">
                    <LAYOUTNODE name="Page Header" width="18.5cm" length="42mm" port="anyPageHeader">
                        <MINIPAGE name="MiniPage80" width="1.38cm" length="18.5cm" bgColor="#621132" layoutDirection="leftToRight">
                            <WORDBOX name="gob.mx" y="5mm" anchorX="1" alignment="center" color="#ffffff" fontName="Arial" fontSize="18pt" fontBold="true" text="gob.mx"/>
                        </MINIPAGE>
                        <MINIPAGE name="StripeLayouter3" width="1.38cm" length="18.5cm" bgColor="#d9d9d9" layoutDirection="leftToRight">
                            <WORDBOX name="ISSSTE" y="max/2" width="min" anchorX="1" anchorY="0.5" alignment="center" fontName="Arial" fontSize="9" textAlignment="center" text="Instituto de Seguridad y Servicios Sociales de los Trabajadores del Estado"/>
                        </MINIPAGE>
                        <MINIPAGE name="MiniPage12" width="12mm" length="18.5cm" layoutDirection="leftToRight">
                            <WORDBOX name="Nombre del formato" y="max/2" width="min" anchorX="1" anchorY="0.5" alignment="center" fontName="Arial" fontSize="12" floatingBehavior="enclosed" textAlignment="center" text="Resolución de transferencia de derechos"/>
                        </MINIPAGE>
                    </LAYOUTNODE>
                    <rtl:match name="FirstPageHeader" nameConstraint="FirstPageHeader" minOccurs="0" maxOccurs="1"/>
                    <LAYOUTNODE name="LayoutNode" width="max" length="min" port="anyPageFooter" floatingBehavior="enclosed">
                        <MINIPAGE name="MiniPage" width="min" length="max" layoutDirection="leftToRight">
                            <WORDBOX name="WordBox" fontName="Arial" fontSize="8" floatingBehavior="enclosed" text="Sello digital:"/>
                            <rtl:input-variable name="sello_digital" type="FGLString" expectedLocation="expectedAhead"/>
                            <WORDWRAPBOX name="sello_digital Value" designHints="fieldName:sello_digital;fieldRole:FormFieldValue" class="grwStringValue" width="max" fontName="Arial" fontSize="8" floatingBehavior="enclosed" text="{{sello_digital}}"/>
                        </MINIPAGE>
                        <MINIPAGE name="Separador_size_6_2_3" width="18.5cm" length="8">
                            <WORDBOX name="WordBox52" floatingBehavior="enclosed" text=" "/>
                        </MINIPAGE>
                        <MINIPAGE name="MiniPage75" width="min" length="min" borderTopWidth="0.5" borderRightWidth="0.5" borderBottomWidth="0.5" borderLeftWidth="0.5" borderStyle="solid">
                            <WORDWRAPBOX name="WordWrapBox4" width="18.35cm" fontName="Arial" fontSize="7" text="En caso de que el Resultado sea PROCEDENTE, deberá validar la información de los periodos y sueldos remitidos por el IMSS en su Expediente Electrónico Único, los cuales estarán identificados como TRANSFERENCIA DE DERECHOS IMSS ISSSTE." textAlignment="justified" paddingLeftWidth="2"/>
