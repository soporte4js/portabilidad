                                <WORDBOX name="WordBox17" floatingBehavior="enclosed" text=" "/>
                            </MINIPAGE>
                            <WORDWRAPBOX name="WordWrapBox5" width="18.35cm" fontName="Arial" fontSize="7" text="Para cualquier aclaración, deberá acudir al Departamento de Afiliación y Prestaciones Económicas del ISSSTE o, en caso de no estar conforme con la respuesta del IMSS, deberá acudir al Departamento de Afiliación y Vigencia de la Subdelegación de ese Instituto; en ambos casos según corresponda conforme a su domicilio." textAlignment="justified" paddingLeftWidth="2"/>
                            <MINIPAGE name="Separador_size_6_2_2" width="18.5cm" length="2">
                                <WORDBOX name="WordBox18" floatingBehavior="enclosed" text=" "/>
                            </MINIPAGE>
                            <WORDWRAPBOX name="WordWrapBox6" width="18.35cm" fontName="Arial" fontSize="7" text="Para la emisión de la Resolución se utilizó la información contenida en la Base de Datos Única de Derechohabientes del ISSSTE integrada de conformidad con lo que establecen los artículos 7; 8 y 13 de la Ley del ISSSTE y los artículos 9 y 64 del Reglamento del Sistema Nacional de Afiliación y Vigencia de Derechos, de la Base de Datos Única de Derechohabientes y del Expediente Electrónico Único del ISSSTE; así como con la información proporcionada por el IMSS a través de los medios electrónicos implementados y autorizados por ambos Institutos." textAlignment="justified" paddingLeftWidth="2"/>
                        </MINIPAGE>
                        <MINIPAGE name="Separador_size_6_2" width="18.5cm" length="8">
